# Copy this file to .env (repo root) and fill in your own values.
# .env is gitignored — never commit real secrets.

# Twitch Helix API app credentials, for runtime/twitch_scrape.py.
# Get these free at https://dev.twitch.tv/console/apps — see the
# instructions in the chat for the exact steps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Meta (Instagram Graph API) app credentials — not wired into any code yet,
# this is just the app registration. See the instructions in the chat for
# the exact steps (Instagram must be a Professional account linked to a
# Facebook Page).
META_CLIENT_ID=
META_CLIENT_SECRET=

# API keys for an API-backed LLM role (cookbook/providers.json) — only the
# one matching whatever provider the cookbook picked actually gets read.
# Get an OpenRouter key at https://openrouter.ai/settings/keys, an xKiro key
# at https://xkiro.com.
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
XKIRO_API_KEY=
LLM_API_KEY=

# API key for an API-backed TTS role (cookbook/providers.json's "fish-audio"
# entry) — get one at https://fish.audio.
FISH_API_KEY=

# API key for an API-backed embedding role (cookbook/providers.json's
# "google" entry) — get one free at https://aistudio.google.com.
GOOGLE_API_KEY=
