# Copy this file to .env (repo root) and fill in your own values.
# .env is gitignored — never commit real secrets.

# Twitch Helix API app credentials, for runtime/twitch_scrape.py.
# Get these free at https://dev.twitch.tv/console/apps — see the
# instructions in the chat for the exact steps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok for Developers app credentials (Login Kit + Display API), for the
# OAuth flow that will replace the yt-dlp-based TikTok post scraper.
# Get these free at https://developers.tiktok.com/ — see the instructions
# in the chat for the exact steps.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the TikTok app's Login
# Kit settings (HTTPS required — a local dev tunnel like cloudflared
# stands in for a real domain until this is deployed).
TIKTOK_REDIRECT_URI=

# Meta (Instagram Graph API) app credentials — not wired into any code yet,
# this is just the app registration. See the instructions in the chat for
# the exact steps (Instagram must be a Professional account linked to a
# Facebook Page).
META_CLIENT_ID=
META_CLIENT_SECRET=
