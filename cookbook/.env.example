# Copy to .env at the repo root. .env is gitignored and must stay that way.
# Keys are read from the environment only — never written into stack.json.

# Anthropic
ANTHROPIC_API_KEY=

# NVIDIA NIM (build.nvidia.com) — free Developer Program key
NVIDIA_API_KEY=

# Any other OpenAI-compatible endpoint selected as the "custom" provider
LLM_API_KEY=
